{
  "version": 2,
  "builds": [
    {
      "src": "package.json",
      "use": "@vercel/static-build",
      "config": {
        "distDir": "dist"
      }
    }
  ],
  "routes": [
    {
      "src": "/api/(.*)",
      "dest": "https://waterbodybackend-production.up.railway.app/api/$1"
    },
    {
      "src": "/Account/(.*)",
      "dest": "https://waterbodybackend-production.up.railway.app/Account/$1"
    },
    {
      "src": "/health/(.*)",
      "dest": "https://waterbodybackend-production.up.railway.app/health/$1"
    },
    {
      "src": "/warning/(.*)",
      "dest": "https://waterbodybackend-production.up.railway.app/warning/$1"
    },
    {
      "src": "/(.*)",
      "dest": "/index.html"
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=0, must-revalidate"
        }
      ]
    }
  ]
}
